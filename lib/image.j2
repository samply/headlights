{#- An image from the `images` config. Its value is a tag on `repo`, or a whole
    image when it has a / or :; either may end in @<digest>, which pins the
    image. -#}
{% macro ref(repo, value) -%}
{%- set name = (value | split("@") | first) -%}
{%- if "/" in name or ":" in name -%}{{ value | tojson }}
{%- elif not name -%}{{ (repo ~ value) | tojson }}
{%- else -%}{{ (repo ~ ":" ~ value) | tojson }}{%- endif %}
{%- endmacro %}

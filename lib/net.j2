{#- Services reach each other through the host, at host.docker.internal:<port>, so it
    makes no difference whether a service runs in a container or, with
    `omit: true`, on the host itself. Each publishes its port 1:1 on every
    interface. A service's config is `services[<name>]`. -#}

{#- Where services are reached: through the host from a container, or at
    127.0.0.1 when `headlights env` renders with on_host=true for a service on the
    host itself -#}
{% macro host() -%}
{{ "127.0.0.1" if on_host | default(false) else "host.docker.internal" }}
{%- endmacro %}

{#- Where `name` is reached, as a quoted URL -#}
{% macro url(name, path="") -%}
{{ ("http://" ~ host() ~ ":" ~ services[name].port ~ path) | tojson }}
{%- endmacro %}

{#- The address `name` listens on, as a quoted string -#}
{% macro listen(name) -%}
{{ ("0.0.0.0:" ~ services[name].port) | tojson }}
{%- endmacro %}

#!/bin/bash
# Renders a project's compose.yaml.j2 with the given config files and runs
# docker compose on the result.
#
#   ./headlights [-c config.yaml]... <project> <compose args...>
#   ./headlights [-c config.yaml]... <project> env <service> [command...]
#   ./headlights [-c config.yaml]... <project> test
#
#   ./headlights dktk up
#   ./headlights dktk test   # run the tests against the running stack
#   ./headlights -c focus-main.yaml dktk config   # print the rendered compose file
#   ./headlights -c no-focus.yaml dktk env focus   # print the env for running focus yourself
#   ./headlights -c no-focus.yaml dktk env focus cargo run   # run focus with it
#
# Config: defaults.yaml, then <project>/defaults.yaml, then $HEADLIGHTS_CONFIG and
# the -c files, each merged over the ones before it.
set -euo pipefail

usage() {
  echo "Usage: $0 [-c config.yaml]... <project> <compose args...>" >&2
  echo "       $0 [-c config.yaml]... <project> env <service> [command...]" >&2
  echo "       $0 [-c config.yaml]... <project> test" >&2
  exit 2
}

root=$(dirname "$(realpath "$0")")
configs=()
# HEADLIGHTS_CONFIG: colon-separated config files applied before -c; missing ones are skipped
IFS=: read -ra preset <<<"${HEADLIGHTS_CONFIG:-}"
for file in "${preset[@]}"; do
  [[ -f $file ]] && configs+=("$file")
done
while getopts c: opt; do
  case $opt in
    c) configs+=("$(realpath "$OPTARG")") ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -ge 2 ]] || usage

project=$1
shift
template=$root/$project/compose.yaml.j2
if [[ ! -f $template ]]; then
  echo "No project '$project'. Projects: $(cd "$root" && ls -d */compose.yaml.j2 | cut -d/ -f1 | paste -sd ' ')" >&2
  exit 1
fi

data=("$root/defaults.yaml")
[[ -f $root/$project/defaults.yaml ]] && data+=("$root/$project/defaults.yaml")
data+=("${configs[@]}")
# Deep-merges the config files in order (minijinja-cli would only merge top-level
# keys) and renders the template; extra arguments go to minijinja-cli
render() {
  yq eval-all '. as $file ireduce ({}; . * $file)' "${data[@]}" |
    minijinja-cli --strict --autoescape none -f yaml "$@" "$template" -
}
rendered=$(render)

# In the container, the entrypoint starts podman's API, so a command run in it right
# away may come before its socket. Without the entrypoint, there is none to wait for.
if [[ ${DOCKER_HOST:-} == unix://* && $(tr '\0' ' ' < /proc/1/cmdline 2> /dev/null) == *container/entrypoint.sh* ]]; then
  for _ in {1..300}; do
    [[ -S ${DOCKER_HOST#unix://} ]] && break
    sleep 0.1
  done
fi

# The compose project is named after the project directory, unless COMPOSE_PROJECT_NAME is set
compose() {
  ${HEADLIGHTS_COMPOSE:-docker compose} \
    --project-directory "$root/$project" \
    -f - "$@" <<<"$rendered"
}

if [[ $1 == env ]]; then
  [[ $# -ge 2 ]] || usage
  service=$2
  shift 2
  # For a service on the host, which reaches the others at 127.0.0.1
  rendered=$(render -D on_host:=true)
  # Services with `omit: true` are only in the `off` profile.
  vars=$(compose --profile off config --format json |
    minijinja-cli --strict --no-newline -f json -D "service=$service" \
      -t '{% for key, value in services[service].environment | items if value is not none %}{{ key }}={{ value }}
{% endfor %}' "" -)
  # Without a command, print the environment; with one, run it in it
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$vars"
    exit
  fi
  mapfile -t assignments <<<"$vars"
  exec env "${assignments[@]}" "$@"
fi

if [[ $1 == test ]]; then
  [[ $# -eq 1 ]] || usage
  # Tests are the services in the `test` profile
  tests=$(comm -13 <(compose config --services | sort) \
    <(compose --profile test config --services | sort))
  if [[ -z $tests ]]; then
    echo "Project '$project' has no tests"
    exit 0
  fi
  failed=()
  for test in $tests; do
    echo "== $test"
    compose --profile test run --rm -T "$test" || failed+=("$test")
  done
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed: ${failed[*]}" >&2
    exit 1
  fi
  echo "All tests passed"
  exit
fi

compose "$@"

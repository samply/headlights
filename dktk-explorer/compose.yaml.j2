{#- The lens3 DKTK explorer with one local site: focus and a Blaze holding testdata/. -#}
{% set components = {
  "lens": dict(lens, port=3000, host_port=3000),
  "proxy-central": dict(port=8081, host_port=8081),
  "proxy-test": dict(port=8081, host_port=8082),
  "blaze": dict(blaze, port=8080, host_port=8090, path="/fhir/"),
  "focus": dict(focus),
} %}
{#- Imported after `components`, which their macros read -#}
{% import "../lib/net.j2" as net %}
{% import "../lib/beam.j2" as beam %}
{% import "../lib/tests.j2" as tests %}
services:
  lens:
    image: {{ lens.image | default("ghcr.io/samply/lens3:dktk-explorer-main") | tojson }}
    {{ net.external("lens") }}
    {{ net.ports("lens") }}
    extra_hosts: ["host.docker.internal:host-gateway"]
    environment:
      BEAM_PROXY_URL: {{ net.url("lens", "proxy-central") }}
      BEAM_APP_ID: lens.central.broker
      BEAM_SECRET: pass123
      SITES: dev
      LENS_DEV_MENU: "true"
      LLM_API_KEY: ${LLM_API_KEY:-}
      LLM_BASE_URL: ${LLM_BASE_URL:-}
      LLM_MODEL: ${LLM_MODEL:-}

  focus:
    # develop until a focus release understands lens3's query format
    image: {{ focus.image | default("samply/focus:develop") | tojson }}
    {{ net.external("focus") }}
    extra_hosts: ["host.docker.internal:host-gateway"]
    # Until its proxy is up
    restart: on-failure
    environment:
      BEAM_PROXY_URL: {{ net.url("focus", "proxy-test") }}
      BEAM_APP_ID_LONG: focus.test.broker
      PROXY_ID: test.broker
      API_KEY: pass123
      ENDPOINT_URL: {{ net.url("focus", "blaze") }}
      OBFUSCATE: "no"

  blaze:
    image: samply/blaze:latest
    {{ net.external("blaze") }}
    {{ net.ports("blaze") }}
    environment:
      JAVA_TOOL_OPTIONS: -Xmx2g

  testdata:
    image: curlimages/curl:latest
    # Its shell loop ignores SIGTERM on its own
    init: true
    {{ net.external("blaze") }}
    volumes:
      - ./testdata:/testdata:ro
    entrypoint: sh -c
    command:
      - >-
        until curl -sf http://blaze:8080/health > /dev/null; do sleep 2; done;
        for f in /testdata/*.json; do
        curl -sf -o /dev/null -X POST -H 'Content-Type: application/fhir+json' --data @$$f http://blaze:8080/fhir;
        done

{{ beam.services({"central": ["lens"], "test": ["focus"]}) }}

{{ tests.lens_query("lens", site="test") }}

volumes:
{{ beam.volumes() }}

{#- BBMRI with the Negotiator: the bbmri search stack querying the two small
    Headlights biobanks from negotiator/fixtures.json, plus Negotiator 3.23 with
    its real frontend, PostgreSQL database and OIDC provider, and the browser
    test (profile `test`) driving the complete handoff, including the OIDC
    login. Only the Directory metadata is a fixture. -#}
{% import "../lib/net.j2" as net %}
{% import "../lib/service.j2" as service %}
{% import "../lib/image.j2" as image %}
{% import "../lib/beam.j2" as beam %}
{% import "../lib/blaze.j2" as blaze %}
{% set sites = "biobank-a,biobank-b" %}
services:
  lens2:
    # The published Locator image with an entrypoint that loads the
    # fixture-generated PUBLIC_LENS_OPTIONS before the server starts.
    image: bbmri-negotiator-locator:local
    build:
      context: ./negotiator
      dockerfile: locator.Dockerfile
    pull_policy: build
    {{ service.head("lens2") }}
    depends_on:
      negotiator-fixtures:
        condition: service_completed_successfully
      directory-fixture:
        condition: service_healthy
    environment:
      # The browser reaches Spot through the host, so this URL is literal.
      PUBLIC_SPOT_URL: http://localhost:{{ services.spot.port }}
      PUBLIC_ENVIRONMENT: test
      DIRECTORY_GRAPHQL_ENDPOINT: http://directory-fixture:8070/graphql
    volumes:
      - negotiator-fixtures:/fixtures:ro
    healthcheck:
      test: [CMD, node, -e, "fetch('http://localhost:3000/search').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"]
      interval: 5s
      timeout: 5s
      retries: 30

  spot:
    image: {{ image.ref("samply/rustyspot", images.spot) }}
    {{ service.head("spot") }}
    environment:
      BIND_ADDR: {{ net.listen("spot") }}
      BEAM_PROXY_URL: {{ net.url("proxy-central") }}
      BEAM_APP_ID: spot.central.broker
      BEAM_SECRET: {{ beam_secret | tojson }}
      CORS_ORIGIN: any
      PRISM_URL: {{ net.url("prism") }}
      TRANSFORM: LENS
      PROJECT: bbmri
      SITES: {{ sites | tojson }}

  prism:
    image: {{ image.ref("samply/prism", images.prism) }}
    {{ service.head("prism") }}
    # Until its proxy is up
    restart: on-failure
    environment:
      BIND_ADDR: {{ net.listen("prism") }}
      BEAM_PROXY_URL: {{ net.url("proxy-central") }}
      BEAM_APP_ID_LONG: prism.central.broker
      API_KEY: {{ beam_secret | tojson }}
      CORS_ORIGIN: any
      PROJECT: bbmri
      SITES: {{ sites | tojson }}
{% for site in sites | split(",") %}

  focus-{{ site }}:
    image: {{ image.ref("samply/focus", images.focus) }}
    {{ service.head("focus-" ~ site) }}
    # Until its proxy is up
    restart: on-failure
    environment:
      BEAM_PROXY_URL: {{ net.url("proxy-" ~ site) }}
      BEAM_APP_ID_LONG: {{ ("focus." ~ site ~ ".broker") | tojson }}
      API_KEY: {{ beam_secret | tojson }}
      ENDPOINT_URL: {{ net.url("blaze-" ~ site, "/fhir/") }}
      OBFUSCATE: "no"
{{ blaze.server("blaze-" ~ site) }}

  # Writes the site's FHIR fixture bundle into a volume of its own name, which
  # the loader below uploads. The site IDs must match negotiator/fixtures.json.
  fixtures-{{ site }}:
    image: node:22-alpine
    {{ service.head("fixtures-" ~ site) }}
    volumes:
      - ./negotiator:/source:ro
      - fixtures-{{ site }}:/fixtures
    command: [node, /source/write-bundles.mjs, {{ site | tojson }}, /fixtures]
{{ blaze.loader("blaze-" ~ site, source="fixtures-" ~ site) }}
{%- endfor %}

{{ beam.network({"central": ["spot", "prism"], "biobank-a": ["focus"], "biobank-b": ["focus"]}) }}

  # The Negotiator services address each other by service name, so none of them
  # publishes a port except the two the browser uses, whose URLs are baked into
  # the redirect URIs and the tokens' issuer: the gateway on 8090 and the OIDC
  # provider on 4011.

  # One-shot: expands negotiator/fixtures.json into the negotiator-fixtures
  # volume, seeding the Negotiator database and generating the Locator's
  # options and the OIDC users.
  negotiator-fixtures:
    image: node:22-alpine
    {{ service.head("negotiator-fixtures") }}
    volumes:
      - ./negotiator:/source:ro
      - negotiator-fixtures:/fixtures
    command: [node, /source/setup.mjs, /fixtures]

  directory-fixture:
    image: node:22-alpine
    {{ service.head("directory-fixture") }}
    volumes:
      - ./negotiator:/fixtures:ro
    command: [node, /fixtures/directory.mjs]
    healthcheck:
      test: [CMD, node, -e, "fetch('http://localhost:8070/health').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"]
      interval: 5s
      timeout: 5s
      retries: 12

  negotiator-db:
    image: postgres:16-alpine
    {{ service.head("negotiator-db") }}
    environment:
      POSTGRES_USER: negotiator
      POSTGRES_PASSWORD: negotiator
      POSTGRES_DB: negotiator
    volumes:
      - negotiator-db:/var/lib/postgresql/data
    healthcheck:
      test: [CMD-SHELL, pg_isready -U negotiator -d negotiator]
      interval: 5s
      timeout: 5s
      retries: 30

  negotiator:
    image: bbmrieric/negotiator:3.23.0
    {{ service.head("negotiator") }}
    depends_on:
      negotiator-db:
        condition: service_healthy
      negotiator-fixtures:
        condition: service_completed_successfully
      # The JWT decoder fetches its keys lazily, but Negotiator must be able to introspect
      # tokens from the first request onwards, so the proxy's health check gates Negotiator
      # on the discovery document being served.
      negotiator-oidc-proxy:
        condition: service_healthy
    environment:
      SPRING_PROFILES_ACTIVE: dev
      SPRING_DATASOURCE_URL: jdbc:postgresql://negotiator-db:5432/negotiator
      SPRING_FLYWAY_LOCATIONS: classpath:db/migration/,filesystem:/fixtures
      # Negotiator's JwtDecoderConfig requires an opaque-token introspection endpoint and puts it
      # in front of the issuer validator, so it cannot simply be dropped. It is pointed at a proxy
      # rather than at the mock directly, because the mock derives the issuer it accepts from the
      # Host header: tokens are minted for http://localhost:4011 (the browser's only route), and
      # the proxy presents that Host header on Negotiator's behalf. See negotiator/oidc-proxy.conf.
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://localhost:4011
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI: http://negotiator-oidc-proxy:8080/.well-known/openid-configuration/jwks
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_USER_INFO_URI: http://negotiator-oidc-proxy:8080/connect/userinfo
      SPRING_SECURITY_OAUTH2_RESOURCESERVER_OPAQUETOKEN_INTROSPECTION_URI: http://negotiator-oidc-proxy:8080/connect/introspect
      SPRING_SECURITY_CORS_ALLOWED_ORIGINS: http://localhost:3000,http://localhost:8090
      NEGOTIATOR_FRONTEND_URL: http://localhost:8090
      MANAGEMENT_HEALTH_MAIL_ENABLED: "false"
      # These tests stop at the request summary; no real email or Directory sync.
      NEGOTIATOR_EMAIL_FREQUENCY_CRON_EXPRESSION: "-"
      NEGOTIATOR_NOTIFICATION_REMINDER_CRON_EXPRESSION: "-"
      SYNCHRONIZATION_FREQUENCY: "-"
    volumes:
      - negotiator-fixtures:/fixtures:ro
    healthcheck:
      test: [CMD, curl, -f, http://localhost:8081/api/actuator/health]
      interval: 5s
      timeout: 5s
      start_period: 60s
      retries: 36

  negotiator-frontend:
    image: bbmrieric/negotiator-frontend:3.23.0
    {{ service.head("negotiator-frontend") }}
    environment:
      AUTH_URL: http://localhost:4011
      CLIENT_ID: auth-code-client
      REDIRECT_URI: http://localhost:8090/logged-in
      LOGOUT_URI: http://localhost:8090
      API_RESOURCES: https://negotiator.bbmri-eric.eu
      SCOPES: openid profile email permissions some-app-scope-1
      AUTOMATIC_SILENT_RENEW: "false"
      SILENT_REDIRECT_URI: http://localhost:8090/silent-renew-oidc.html
      MATOMO_HOST: MATOMO_HOST_PLACEHOLDER

  negotiator-gateway:
    image: nginx:1.28-alpine
    {{ service.head("negotiator-gateway") }}
    depends_on:
      negotiator:
        condition: service_healthy
      negotiator-frontend:
        condition: service_started
    volumes:
      - ./negotiator/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: [CMD-SHELL, "wget -q -O /dev/null http://127.0.0.1:8090/ && wget -q -O /dev/null http://127.0.0.1:8090/api/actuator/health"]
      interval: 5s
      timeout: 5s
      retries: 30

  negotiator-oidc:
    image: ghcr.io/soluto/oidc-server-mock:0.9.2
    platform: linux/amd64
    {{ service.head("negotiator-oidc") }}
    depends_on:
      negotiator-fixtures:
        condition: service_completed_successfully
    environment:
      # Listens on its published port 1:1, so the proxy can pass for it.
      ASPNETCORE_URLS: http://+:4011
      ASPNETCORE_ENVIRONMENT: Development
      LOGIN_OPTIONS_INLINE: '{"AllowRememberLogin":false}'
      LOGOUT_OPTIONS_INLINE: '{"AutomaticRedirectAfterSignOut":true}'
      SERVER_OPTIONS_INLINE: '{"AccessTokenJwtType":"JWT","Discovery":{"ShowKeySet":true},"Authentication":{"CookieSameSiteMode":"Lax","CheckSessionCookieSameSiteMode":"Lax"}}'
      API_SCOPES_INLINE: '[{"Name":"some-app-scope-1"}]'
      API_RESOURCES_INLINE: '[{"Name":"https://negotiator.bbmri-eric.eu","Scopes":["some-app-scope-1"],"ApiSecrets":["negotiator-secret"]}]'
      IDENTITY_RESOURCES_INLINE: '[{"Name":"permissions","ClaimTypes":["eduperson_entitlement"]}]'
      CLIENTS_CONFIGURATION_PATH: /config/clients.json
      USERS_CONFIGURATION_PATH: /fixtures/users.json
    volumes:
      - ./negotiator/oidc:/config:ro
      - negotiator-fixtures:/fixtures:ro

  # Re-presents the OIDC mock under the issuer the tokens were actually minted for. See
  # negotiator/oidc-proxy.conf for why this cannot be a direct connection. Its health check
  # doubles as the discovery-document gate for the Negotiator, and the 24 retries
  # (~2 minutes) cover a slow mock start.
  negotiator-oidc-proxy:
    image: nginx:1.28-alpine
    {{ service.head("negotiator-oidc-proxy") }}
    depends_on:
      - negotiator-oidc
    volumes:
      - ./negotiator/oidc-proxy.conf:/etc/nginx/conf.d/default.conf:ro
    healthcheck:
      test: [CMD-SHELL, "wget -q -O /dev/null http://127.0.0.1:8080/.well-known/openid-configuration"]
      interval: 5s
      timeout: 5s
      retries: 24

  test-handoff:
    # Serves literal localhost URLs, which only resolve on the host itself.
    image: mcr.microsoft.com/playwright:v1.59.1-noble
    {{ service.head("test-handoff", test=true) }}
    network_mode: host
    depends_on:
      lens2:
        condition: service_healthy
      negotiator-gateway:
        condition: service_healthy
    working_dir: /test
    environment:
      - CI=${CI}
    volumes:
      - ./negotiator:/test/negotiator:ro
      - ./playwright.negotiator.config.ts:/test/playwright.negotiator.config.ts:ro
      - ./test-results:/test/test-results
      - ./playwright-report:/test/playwright-report
    command: bash -c 'npm i @playwright/test@1.59.1 && npx playwright test --config playwright.negotiator.config.ts'

volumes:
{{ beam.volumes() }}
{{- blaze.volumes() }}
  fixtures-biobank-a:
  fixtures-biobank-b:
  negotiator-fixtures:
  negotiator-db:

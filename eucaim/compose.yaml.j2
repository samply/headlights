{#- EUCAIM: the lens2 EUCAIM explorer with spot, querying two sites. Each site's focus
    asks a responder that stands in for the provider's OMOP endpoint. -#}
{% import "../lib/net.j2" as net %}
{% import "../lib/service.j2" as service %}
{% import "../lib/image.j2" as image %}
{% import "../lib/beam.j2" as beam %}
{% import "../lib/tests.j2" as tests %}
services:
  lens2:
    image: {{ image.ref("samply/eucaim-frontend", images.lens2) }}
    {{ service.head("lens2") }}
    environment:
      HOST: 0.0.0.0
      PORT: {{ services.lens2.port | string | tojson }}
      PUBLIC_SPOT_URL: http://localhost:{{ services.spot.port }}

  spot:
    image: {{ image.ref("samply/rustyspot", images.spot) }}
    {{ service.head("spot") }}
    environment:
      BIND_ADDR: {{ net.listen("spot") }}
      BEAM_PROXY_URL: {{ net.url("proxy-central") }}
      BEAM_APP_ID: spot.central.broker
      BEAM_SECRET: {{ beam_secret | tojson }}
      CORS_ORIGIN: any
      PROJECT: eucaim
      SITES: chaimeleon,procanceri

  focus-chaimeleon:
    image: {{ image.ref("samply/focus", images.focus) }}
    {{ service.head("focus-chaimeleon") }}
    # Until its proxy is up
    restart: on-failure
    environment:
      BEAM_PROXY_URL: {{ net.url("proxy-chaimeleon") }}
      BEAM_APP_ID_LONG: focus.chaimeleon.broker
      API_KEY: {{ beam_secret | tojson }}
      ENDPOINT_TYPE: omop
      ENDPOINT_URL: {{ net.url("responder-chaimeleon") }}
      PROVIDER: CHAIMELEON
      PROVIDER_ICON: ""

  responder-chaimeleon:
    image: docker.verbis.dkfz.de/eucaim/responder:chaimeleon
    {{ service.head("responder-chaimeleon") }}
    # Answers every query with the image's response.json; the port comes after it
    command: ["./responder.py", "response", {{ services["responder-chaimeleon"].port | string | tojson }}]

  focus-procanceri:
    image: {{ image.ref("samply/focus", images.focus) }}
    {{ service.head("focus-procanceri") }}
    # Until its proxy is up
    restart: on-failure
    environment:
      BEAM_PROXY_URL: {{ net.url("proxy-procanceri") }}
      BEAM_APP_ID_LONG: focus.procanceri.broker
      API_KEY: {{ beam_secret | tojson }}
      ENDPOINT_TYPE: omop
      ENDPOINT_URL: {{ net.url("responder-procanceri") }}
      PROVIDER: ProCancerI
      PROVIDER_ICON: ""

  responder-procanceri:
    image: docker.verbis.dkfz.de/eucaim/responder:procanceri
    {{ service.head("responder-procanceri") }}
    # Answers every query with the image's procanceri.json; the port comes after it
    command: ["./responder.py", "procanceri", {{ services["responder-procanceri"].port | string | tojson }}]

{{ beam.network({"central": ["spot"], "chaimeleon": ["focus"], "procanceri": ["focus"]}) }}

{#- focus's OMOP endpoint takes the AST under `query` rather than `payload`; base64
    of {"ast":{"operand":"OR","children":[]},"id":"00000000-0000-0000-0000-000000000000"} -#}
{{ tests.spot_query("spot", query='{"lang":"ast","query":"eyJhc3QiOnsib3BlcmFuZCI6Ik9SIiwiY2hpbGRyZW4iOltdfSwiaWQiOiIwMDAwMDAwMC0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDAifQ=="}') }}

volumes:
{{ beam.volumes() }}
